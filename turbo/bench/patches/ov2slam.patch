+%YAML 1.0
+---
+# TUM RGB-D freiburg3 (images are already undistorted), otherwise parameters_files/accurate/euroc/euroc_mono.yaml
+
+#--------------------------------------------------------------------------------------------
+# Camera Parameters. Adjust them!
+#--------------------------------------------------------------------------------------------
+
+Camera.topic_left: /cam0/image_raw
+Camera.topic_right: /cam1/image_raw
+
+Camera.model_left: pinhole
+Camera.model_right: pinhole
+
+Camera.left_nwidth: 640
+Camera.left_nheight: 480
+
+Camera.right_nwidth: 640
+Camera.right_nheight: 480
+
+# Camera calibration and distortion parameters (OpenCV) 
+Camera.fxl: 535.4
+Camera.fyl: 539.2
+Camera.cxl: 320.1
+Camera.cyl: 247.6
+
+Camera.k1l: 0.
+Camera.k2l: 0.
+Camera.p1l: 0.
+Camera.p2l: 0.
+
+Camera.fxr: 457.587
+Camera.fyr: 456.134
+Camera.cxr: 379.999
+Camera.cyr: 255.238
+
+Camera.k1r: -0.28368365
+Camera.k2r: 0.07451284
+Camera.p1r: -0.00010473
+Camera.p2r: -3.555907e-05
+
+# Camera Extrinsic parameters T_b_ci ( v_b = T_b_ci * v_ci )
+body_T_cam0: !!opencv-matrix
+   rows: 4
+   cols: 4
+   dt: d
+   data: [0.0148655429818, -0.999880929698, 0.00414029679422, -0.0216401454975,
+           0.999557249008, 0.0149672133247, 0.025715529948,  -0.064676986768,
+           -0.0257744366974, 0.00375618835797, 0.999660727178, 0.00981073058949,
+           0., 0., 0., 1.]
+
+body_T_cam1: !!opencv-matrix
+   rows: 4
+   cols: 4
+   dt: d
+   data: [0.0125552670891, -0.999755099723, 0.0182237714554, -0.0198435579556,
+           0.999598781151, 0.0130119051815, 0.0251588363115, 0.0453689425024,
+          -0.0253898008918, 0.0179005838253, 0.999517347078, 0.00786212447038,
+          0., 0., 0., 1.]
+
+#--------------------------------------------------------------------------------------------
+# SLAM Parameters. Adjust them!
+#--------------------------------------------------------------------------------------------
+debug: 0
+log_timings: 0
+
+mono: 1
+stereo: 0
+
+force_realtime: 0
+
+# Estimator Mode
+slam_mode: 1
+
+# Loop Closing mode
+buse_loop_closer: 0
+
+# Stereo rectify or not
+bdo_stereo_rect: 0
+alpha: 0.
+
+# Undist Image or not
+bdo_undist: 0
+
+# Init / KF px th.
+finit_parallax: 20.
+
+# Features Extractor
+use_shi_tomasi: 0
+use_fast: 0
+use_brief: 1
+use_singlescale_detector: 1
+
+# Min dist between kps (define the number of kps)
+nmaxdist: 35
+
+# Features quality th.
+nfast_th: 10
+dmaxquality: 0.001 # used for gftt or singlescale
+
+# Pre-processing
+use_clahe: 1
+fclahe_val: 3
+
+# KLT related settings.
+do_klt: 1
+klt_use_prior: 1
+btrack_keyframetoframe: 0
+nklt_win_size: 9
+nklt_pyr_lvl: 3
+
+# Opencv Default: 30 iters. + 0.01 prec.
+nmax_iter: 30
+fmax_px_precision: 0.01
+
+fmax_fbklt_dist: 0.5
+nklt_err: 30.
+
+# Matching th.
+bdo_track_localmap: 1
+
+fmax_desc_dist: 0.2 #0.35 # Ratio from desc size (for binary desc.) 
+fmax_proj_pxdist: 2.
+
+# Randomize RANSAC?
+doepipolar: 1
+dop3p : 0
+bdo_random: 1
+nransac_iter: 100
+fransac_err: 3.
+
+# Reproj err th.
+fmax_reproj_err: 3.
+buse_inv_depth: 1
+
+# Ceres related parameters
+robust_mono_th: 5.9915 # (20% : 3.2189 / 10% :  4.6052 / 5% : 5.9915 / 2%: 7.8240 / 1%: 9.2103)  
+
+use_sparse_schur: 1
+use_dogleg: 0
+use_subspace_dogleg: 0
+use_nonmonotic_step: 0
+
+# Estimator parameters
+apply_l2_after_robust: 1
+
+nmin_covscore: 25 # Min co-obs for optimizing in SLAM mode BA
+
+# Map Filtering
+fkf_filtering_ratio: 0.95
+
+# Final Pass
+do_full_ba: 0
\ No newline at end of file
diff --git a/standalone/tum_main.cpp b/standalone/tum_main.cpp
new file mode 100644
index 0000000..3607da2
--- /dev/null
+++ b/standalone/tum_main.cpp
@@ -0,0 +1,168 @@
+// Standalone (ROS-free) OV²SLAM driver for TUM-format RGB sequences.
+//
+//   ov2slam_tum params.yaml /path/to/rgbd_dataset_xxx out_prefix [--async] [--max-frames N]
+//
+// By default every frame waits until the mapper / estimator threads have finished processing
+// the previous keyframe (deterministic scheduling, "infinitely fast" back-end).  --async instead
+// replays the images at their recorded rate, as the ROS node would do.
+
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <opencv2/imgcodecs.hpp>
+
+#include "ov2slam.hpp"
+
+static void waitIdle(SlamManager &slam)
+{
+    auto &mapper = *slam.pmapper_;
+    auto &estimator = *mapper.pestimator_;
+    while( mapper.bbusy_ || estimator.bbusy_ || slam.pslamstate_->blocalba_is_on_ ) {
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+}
+
+static void writeTUM(const std::string &filename, const std::vector<std::pair<double, Sophus::SE3d>> &poses)
+{
+    std::ofstream f(filename);
+    f << std::fixed;
+    for( const auto &tp : poses ) {
+        const Eigen::Vector3d t = tp.second.translation();
+        const Eigen::Quaterniond q = tp.second.unit_quaternion();
+        f << std::setprecision(6) << tp.first << " " << std::setprecision(9)
+          << t.x() << " " << t.y() << " " << t.z() << " "
+          << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if( argc < 4 ) {
+        std::cerr << "usage: " << argv[0] << " params.yaml dataset_dir out_prefix [--async] [--max-frames N]\n";
+        return 1;
+    }
+    const std::string params_file = argv[1];
+    const std::string dataset_dir = argv[2];
+    const std::string out_prefix = argv[3];
+    bool sync = true;
+    long max_frames = -1;
+    for( int i = 4 ; i < argc ; i++ ) {
+        std::string a = argv[i];
+        if( a == "--async" ) sync = false;
+        else if( a == "--max-frames" && i + 1 < argc ) max_frames = std::stol(argv[++i]);
+    }
+
+    cv::FileStorage fs(params_file, cv::FileStorage::READ);
+    if( !fs.isOpened() ) {
+        std::cerr << "cannot open " << params_file << "\n";
+        return 1;
+    }
+    auto pparams = std::make_shared<SlamParams>(fs);
+    pparams->bsync_ = sync;
+    auto pviz = std::make_shared<RosVisualizer>();
+
+    // Read the image list
+    std::vector<std::pair<double, std::string>> images;
+    {
+        std::ifstream f(dataset_dir + "/rgb.txt");
+        std::string line;
+        while( std::getline(f, line) ) {
+            if( line.empty() || line[0] == '#' ) continue;
+            std::istringstream ss(line);
+            double t; std::string fn;
+            ss >> t >> fn;
+            images.emplace_back(t, fn);
+        }
+    }
+    std::cout << "\n" << images.size() << " images\n";
+
+    SlamManager slam(pparams, pviz);
+
+    // All poses emitted online (one per processed frame), and the reset count
+    std::vector<std::pair<double, Sophus::SE3d>> online;
+    int nresets = 0;
+
+    auto wall0 = std::chrono::steady_clock::now();
+    for( size_t i = 0 ; i < images.size() ; i++ )
+    {
+        if( max_frames >= 0 && (long)i >= max_frames ) break;
+        const double time = images[i].first;
+
+        if( !sync ) {
+            // Replay at recorded rate
+            double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - wall0).count();
+            double target = time - images[0].first;
+            if( target > elapsed )
+                std::this_thread::sleep_for(std::chrono::duration<double>(target - elapsed));
+        }
+
+        cv::Mat img = cv::imread(dataset_dir + "/" + images[i].second, cv::IMREAD_GRAYSCALE);
+        if( img.empty() ) {
+            std::cerr << "cannot read " << images[i].second << "\n";
+            continue;
+        }
+
+        if( slam.pslamstate_->bdo_undist_ ) {
+            slam.pcalib_model_left_->rectifyImage(img, img);
+        }
+
+        slam.frame_id_++;
+        slam.pcurframe_->updateFrame(slam.frame_id_, time);
+
+        bool is_kf_req = slam.pvisualfrontend_->visualTracking(img, time);
+
+        Logger::addSE3Pose(time, slam.pcurframe_->getTwc(), is_kf_req);
+
+        if( slam.pslamstate_->breset_req_ ) {
+            if( sync ) waitIdle(slam);
+            slam.reset();
+            online.clear();
+            nresets++;
+            continue;
+        }
+
+        if( slam.pslamstate_->bvision_init_ ) {
+            online.emplace_back(time, slam.pcurframe_->getTwc());
+        }
+
+        if( is_kf_req ) {
+            Keyframe kf(slam.pcurframe_->kfid_, img);
+            slam.pmapper_->addNewKf(kf);
+        }
+
+        if( sync ) waitIdle(slam);
+
+        if( i % 100 == 0 ) {
+            std::cout << "\n[ov2slam_tum] frame " << i << " / kfs " << slam.pmap_->nbkfs_
+                      << " / 3d kps " << slam.pcurframe_->nb3dkps_ << std::flush;
+        }
+    }
+
+    waitIdle(slam);
+    double wall = std::chrono::duration<double>(std::chrono::steady_clock::now() - wall0).count();
+
+    writeTUM(out_prefix + "_online.txt", online);
+
+    std::vector<std::pair<double, Sophus::SE3d>> kfposes;
+    for( const auto &kfid_pkf : slam.pmap_->map_pkfs_ ) {
+        if( kfid_pkf.second != nullptr )
+            kfposes.emplace_back(kfid_pkf.second->img_time_, kfid_pkf.second->getTwc());
+    }
+    std::sort(kfposes.begin(), kfposes.end(), [](auto &a, auto &b) { return a.first < b.first; });
+    writeTUM(out_prefix + "_kfs.txt", kfposes);
+
+    std::cout << "\n\n[ov2slam_tum] done: " << online.size() << " online poses, " << kfposes.size()
+              << " KFs, " << nresets << " resets, " << wall << " s\n";
+
+    slam.pmapper_->bexit_required_ = true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    std::cout << std::flush;
+    std::_Exit(0);
+}
