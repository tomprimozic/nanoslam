+cmake_minimum_required(VERSION 3.10)
+project(ov2slam_standalone)
+
+# ROS-free build of OV²SLAM with a TUM-sequence driver (see tum_main.cpp).
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_BUILD_TYPE Release)
+set(CMAKE_CXX_FLAGS_RELEASE "-O3 -g -march=native -Wno-deprecated-declarations")
+
+set(OV2SLAM_ROOT ${CMAKE_CURRENT_SOURCE_DIR}/..)
+
+find_package(OpenCV REQUIRED)
+find_package(Eigen3 3.3 REQUIRED NO_MODULE)
+find_package(Ceres REQUIRED NO_DEFAULT_PATH PATHS ${OV2SLAM_ROOT}/Thirdparty/ceres-solver/install)
+find_package(opengv QUIET PATHS $ENV{HOME}/my/lib/opengv/install NO_DEFAULT_PATH)
+
+add_definitions(-DOPENCV_CONTRIB -DOV2SLAM_NO_ROS)
+if(opengv_FOUND)
+  message(STATUS "OpenGV found: ${opengv_DIR}")
+  add_definitions(-DUSE_OPENGV)
+endif()
+
+add_library(ov2slam STATIC
+  ${OV2SLAM_ROOT}/src/ov2slam.cpp
+  ${OV2SLAM_ROOT}/src/visual_front_end.cpp
+  ${OV2SLAM_ROOT}/src/frame.cpp
+  ${OV2SLAM_ROOT}/src/slam_params.cpp
+  ${OV2SLAM_ROOT}/src/camera_calibration.cpp
+  ${OV2SLAM_ROOT}/src/feature_extractor.cpp
+  ${OV2SLAM_ROOT}/src/feature_tracker.cpp
+  ${OV2SLAM_ROOT}/src/map_manager.cpp
+  ${OV2SLAM_ROOT}/src/map_point.cpp
+  ${OV2SLAM_ROOT}/src/mapper.cpp
+  ${OV2SLAM_ROOT}/src/multi_view_geometry.cpp
+  ${OV2SLAM_ROOT}/src/ceres_parametrization.cpp
+  ${OV2SLAM_ROOT}/src/optimizer.cpp
+  ${OV2SLAM_ROOT}/src/estimator.cpp
+  ${OV2SLAM_ROOT}/src/loop_closer.cpp
+)
+target_include_directories(ov2slam PUBLIC
+  ${CMAKE_CURRENT_SOURCE_DIR}/shim
+  ${OV2SLAM_ROOT}/include
+  ${OV2SLAM_ROOT}/include/ceres_parametrization
+  ${OV2SLAM_ROOT}/Thirdparty/Sophus
+)
+target_link_libraries(ov2slam PUBLIC Eigen3::Eigen ${OpenCV_LIBS} Ceres::ceres)
+if(opengv_FOUND)
+  target_link_libraries(ov2slam PUBLIC opengv)
+endif()
+
+if(EXISTS "${OV2SLAM_ROOT}/Thirdparty/ibow_lcd/build/liblcdetector.so")
+  message(STATUS "iBoW-LCD found: loop closing enabled")
+  target_compile_definitions(ov2slam PUBLIC IBOW_LCD)
+  target_include_directories(ov2slam PUBLIC ${OV2SLAM_ROOT}/Thirdparty/obindex2/lib/include/ ${OV2SLAM_ROOT}/Thirdparty/ibow_lcd/include/)
+  target_link_libraries(ov2slam PUBLIC ${OV2SLAM_ROOT}/Thirdparty/ibow_lcd/build/liblcdetector.so)
+endif()
+
+add_executable(ov2slam_tum tum_main.cpp)
+target_link_libraries(ov2slam_tum PRIVATE ov2slam)
+
+add_executable(ov2slam_bench bench_main.cpp)
+target_link_libraries(ov2slam_bench PRIVATE ov2slam)
diff --git a/standalone/bench_main.cpp b/standalone/bench_main.cpp
new file mode 100644
index 0000000..e83a17a
--- /dev/null
+++ b/standalone/bench_main.cpp
@@ -0,0 +1,199 @@
+// Standalone (ROS-free) OV²SLAM driver for benchmarking (monocular).
+//
+//   ov2slam_bench params.yaml frames.txt out_prefix [--async]
+//
+// frames.txt: one "timestamp image_path" per line. Writes
+//   <out_prefix>_live.txt  the pose of every tracked frame as estimated at that frame (TUM format; resets do not
+//                          erase earlier poses: after a reset the poses are in the new map's frame)
+//   <out_prefix>_kfs.txt   the keyframe poses at the end (after loop closures / full BA when enabled)
+//   <out_prefix>_info.txt  key=value: frames, resets, seconds
+// By default every frame waits until the mapper / estimator threads are idle (deterministic, "infinitely fast"
+// back-end); --async runs them concurrently at full speed.
+
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <opencv2/imgcodecs.hpp>
+
+#include "ov2slam.hpp"
+
+static void waitIdle(SlamManager &slam)
+{
+    auto &mapper = *slam.pmapper_;
+    auto &estimator = *mapper.pestimator_;
+    while( mapper.bbusy_ || estimator.bbusy_ || slam.pslamstate_->blocalba_is_on_ || slam.pslamstate_->blc_is_on_ ) {
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+}
+
+static void writeTUM(const std::string &filename, const std::vector<std::pair<double, Sophus::SE3d>> &poses)
+{
+    std::ofstream f(filename);
+    f << std::fixed;
+    for( const auto &tp : poses ) {
+        const Eigen::Vector3d t = tp.second.translation();
+        const Eigen::Quaterniond q = tp.second.unit_quaternion();
+        f << std::setprecision(6) << tp.first << " " << std::setprecision(9)
+          << t.x() << " " << t.y() << " " << t.z() << " "
+          << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if( argc < 4 ) {
+        std::cerr << "usage: " << argv[0] << " params.yaml frames.txt out_prefix [--async]\n";
+        return 1;
+    }
+    const std::string params_file = argv[1];
+    const std::string frames_file = argv[2];
+    const std::string out_prefix = argv[3];
+    bool sync = true;
+    for( int i = 4 ; i < argc ; i++ ) {
+        if( std::string(argv[i]) == "--async" ) sync = false;
+    }
+
+    cv::FileStorage fs(params_file, cv::FileStorage::READ);
+    if( !fs.isOpened() ) {
+        std::cerr << "cannot open " << params_file << "\n";
+        return 1;
+    }
+    auto pparams = std::make_shared<SlamParams>(fs);
+    pparams->bsync_ = sync;
+    auto pviz = std::make_shared<RosVisualizer>();
+
+    std::vector<std::pair<double, std::string>> images;
+    {
+        std::ifstream f(frames_file);
+        std::string line;
+        while( std::getline(f, line) ) {
+            if( line.empty() || line[0] == '#' ) continue;
+            std::istringstream ss(line);
+            double t; std::string fn;
+            ss >> t >> fn;
+            images.emplace_back(t, fn);
+        }
+    }
+    std::cout << "\n" << images.size() << " images\n";
+
+    SlamManager slam(pparams, pviz);
+
+    std::vector<std::pair<double, Sophus::SE3d>> live;
+    std::ofstream flive(out_prefix + "_live.txt");   // written as we go: a crash keeps the poses so far
+    flive << std::fixed;
+    // belief log: after every frame the keyframes whose pose changed ("S <time>", then "<keyframe time> <T_wc>");
+    // removed keyframes are gone (their last pose stays)
+    std::ofstream fbel(out_prefix + "_beliefs.txt");
+    fbel << std::fixed;
+    std::map<int, Eigen::Matrix4d> last;
+    int nresets = 0;
+
+    auto wall0 = std::chrono::steady_clock::now();
+    for( size_t i = 0 ; i < images.size() ; i++ )
+    {
+        const double time = images[i].first;
+        cv::Mat img;
+        for( int attempt = 0 ; attempt < 5 && img.empty() ; attempt++ ) {   // (transient read errors seen on the server)
+            if( attempt ) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            img = cv::imread(images[i].second, cv::IMREAD_GRAYSCALE);
+        }
+        if( img.empty() ) {
+            std::cerr << "cannot read " << images[i].second << ", frame skipped\n";
+            continue;
+        }
+        if( slam.pslamstate_->bdo_undist_ ) {
+            slam.pcalib_model_left_->rectifyImage(img, img);
+        }
+
+        slam.frame_id_++;
+        slam.pcurframe_->updateFrame(slam.frame_id_, time);
+
+        bool is_kf_req = slam.pvisualfrontend_->visualTracking(img, time);
+
+        Logger::addSE3Pose(time, slam.pcurframe_->getTwc(), is_kf_req);
+
+        if( slam.pslamstate_->breset_req_ ) {
+            waitIdle(slam);
+            slam.reset();
+            last.clear();     // (keyframe ids start again)
+            nresets++;
+            continue;
+        }
+
+        if( slam.pslamstate_->bvision_init_ ) {
+            live.emplace_back(time, slam.pcurframe_->getTwc());
+            const Sophus::SE3d &T = live.back().second;
+            const Eigen::Vector3d t = T.translation();
+            const Eigen::Quaterniond q = T.unit_quaternion();
+            flive << std::setprecision(6) << time << " " << std::setprecision(9) << t.x() << " " << t.y() << " "
+                  << t.z() << " " << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << std::endl;
+        }
+
+        if( is_kf_req ) {
+            Keyframe kf(slam.pcurframe_->kfid_, img);
+            slam.pmapper_->addNewKf(kf);
+        }
+
+        if( sync ) waitIdle(slam);
+
+        {
+            bool header = false;
+            for( const auto &kfid_pkf : slam.pmap_->map_pkfs_ ) {
+                if( kfid_pkf.second == nullptr ) continue;
+                const Sophus::SE3d T = kfid_pkf.second->getTwc();
+                auto it = last.find(kfid_pkf.first);
+                if( it != last.end() && (T.matrix() - it->second).cwiseAbs().maxCoeff() < 1e-7 ) continue;
+                if( !header ) { fbel << "S " << std::setprecision(6) << time << "\n"; header = true; }
+                const Eigen::Vector3d t = T.translation();
+                const Eigen::Quaterniond q = T.unit_quaternion();
+                fbel << std::setprecision(6) << kfid_pkf.second->img_time_ << " " << std::setprecision(9) << t.x() << " "
+                     << t.y() << " " << t.z() << " " << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+                last[kfid_pkf.first] = T.matrix();
+            }
+        }
+
+        if( i % 500 == 0 ) {
+            std::cout << "\n[ov2slam_bench] frame " << i << " / kfs " << slam.pmap_->nbkfs_
+                      << " / 3d kps " << slam.pcurframe_->nb3dkps_ << std::flush;
+        }
+    }
+
+    waitIdle(slam);
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    waitIdle(slam);
+
+    if( slam.pslamstate_->do_full_ba_ ) {
+        std::lock_guard<std::mutex> lock(slam.pmap_->map_mutex_);
+        slam.pmapper_->runFullBA();
+    }
+    double wall = std::chrono::duration<double>(std::chrono::steady_clock::now() - wall0).count();
+
+    flive.close();
+    fbel.close();
+
+    std::vector<std::pair<double, Sophus::SE3d>> kfposes;
+    for( const auto &kfid_pkf : slam.pmap_->map_pkfs_ ) {
+        if( kfid_pkf.second != nullptr )
+            kfposes.emplace_back(kfid_pkf.second->img_time_, kfid_pkf.second->getTwc());
+    }
+    std::sort(kfposes.begin(), kfposes.end(), [](auto &a, auto &b) { return a.first < b.first; });
+    writeTUM(out_prefix + "_kfs.txt", kfposes);
+
+    std::ofstream(out_prefix + "_info.txt") << "frames=" << images.size() << "\nresets=" << nresets
+                                             << "\nseconds=" << wall << "\n";
+    std::cout << "\n\n[ov2slam_bench] done: " << live.size() << " live poses, " << kfposes.size()
+              << " KFs, " << nresets << " resets, " << wall << " s\n";
+
+    slam.pmapper_->bexit_required_ = true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    std::cout << std::flush;
+    std::_Exit(0);
+}
diff --git a/standalone/shim/pcl_ros/point_cloud.h b/standalone/shim/pcl_ros/point_cloud.h
new file mode 100644
index 0000000..2f4801e
--- /dev/null
+++ b/standalone/shim/pcl_ros/point_cloud.h
@@ -0,0 +1,20 @@
+#pragma once
+// Minimal stand-in for the PCL point cloud used for visualization only.
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace pcl {
+struct PointXYZRGB {
+    float x = 0.f, y = 0.f, z = 0.f;
+    std::uint8_t r = 0, g = 0, b = 0;
+    PointXYZRGB() = default;
+    PointXYZRGB(std::uint8_t r_, std::uint8_t g_, std::uint8_t b_) : r(r_), g(g_), b(b_) {}
+};
+
+template <typename PointT>
+struct PointCloud {
+    using Ptr = std::shared_ptr<PointCloud<PointT>>;
+    std::vector<PointT> points;
+};
+}
